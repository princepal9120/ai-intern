    document.querySelectorAll('.resolve-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        target.textContent = '✓ Resolved';
        target.classList.remove('text-teal-400', 'border-teal-500/40');
        target.classList.add('text-emerald-400', 'border-emerald-500/40', 'bg-emerald-500/10');
      });
    });

    const replayBtn = document.getElementById('hero-replay-btn');
    if (replayBtn) {
      replayBtn.addEventListener('click', () => {
        replayBtn.textContent = 'Running...';
        setTimeout(() => {
          replayBtn.textContent = '↻ Replayed';
          setTimeout(() => { replayBtn.textContent = '↻ Replay'; }, 1500);
        }, 800);
      });
    }
