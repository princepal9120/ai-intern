---
---
<div class="font-sans antialiased bg-[#08090b] text-gray-100 selection:bg-teal-400 selection:text-black overflow-x-hidden">
  <div class="fixed inset-0 z-[-1] grid-bg h-screen w-full pointer-events-none"></div>

  <!-- Announcement Bar -->
  <div class="bg-gradient-to-r from-teal-950 via-zinc-900 to-teal-950 border-b border-teal-500/20 py-2.5 px-4 text-center text-xs sm:text-sm font-tech">
    <a href="/docs/overview" class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors group">
      <span class="bg-teal-400/10 text-teal-400 border border-teal-400/30 px-2 py-0.5 rounded-full text-[11px] font-bold tracking-wide uppercase">Announcement 4 Sept</span>
      <img src="/assets/capy/capy-avatar-1.webp" alt="Capy Team" class="w-4 h-4 rounded-full inline-block" />
      <span class="font-medium text-white group-hover:underline">Connect Capy to your Tailscale tailnet</span>
      <span class="text-teal-400 font-bold ml-1 transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>

  <!-- Sticky Header -->
  <header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#08090b]/90 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-18 py-3 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center p-1.5 shadow-[2px_2px_0px_0px_#fff]">
            <img src="/assets/capy/feature.f873fd82.webp" alt="Capy" class="w-full h-full object-contain" />
          </div>
          <div class="flex flex-col">
            <span class="font-display text-2xl sm:text-3xl tracking-wide text-white leading-none">AI INTERN</span>
            <span class="font-tech text-[10px] text-teal-400 tracking-wider">POWERED BY CAPY</span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-6 font-tech text-sm">
          <a href="#use-cases" class="text-gray-300 hover:text-white hover:underline transition-colors">Use Cases</a>
          <a href="#features" class="text-gray-300 hover:text-white hover:underline transition-colors">Features</a>
          <a href="#integrations" class="text-gray-300 hover:text-white hover:underline transition-colors">Integrations</a>
          <a href="#enterprise" class="text-gray-300 hover:text-white hover:underline transition-colors">Enterprise</a>
          <a href="#pricing" class="text-gray-300 hover:text-white hover:underline transition-colors">Pricing</a>
          <a href="/docs/overview" class="text-gray-300 hover:text-white hover:underline transition-colors">Docs</a>
        </nav>
      </div>

      <div class="flex items-center gap-3 sm:gap-4">
        <a href="/app" class="hidden sm:inline-block font-tech text-sm text-gray-300 hover:text-white transition-colors px-3 py-1.5">Sign in</a>
        <a href="/docs/getting-started" class="relative group inline-flex items-center gap-2 font-display text-lg tracking-wider bg-teal-400 text-black px-5 py-2 rounded-xl comic-btn-shadow border border-teal-300">
          <span>Get started</span>
          <img src="/assets/capy/capy-sleeping.webp" alt="Capy resting" class="w-6 h-auto -mr-1 transition-transform group-hover:-translate-y-1" />
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="relative pt-16 sm:pt-24 pb-20 overflow-hidden text-center">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col items-center">
        <!-- New Capy Pill -->
        <a href="#features" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-zinc-900/80 border border-teal-500/30 text-teal-300 text-xs sm:text-sm font-tech mb-6 hover:border-teal-400 transition-colors shadow-lg">
          <span class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></span>
          <span>New Capy V2 is here</span>
          <span class="font-bold">→</span>
        </a>

        <!-- Hero Headline -->
        <h1 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight text-white uppercase leading-[0.9] max-w-5xl mb-6">
          THE BEST SELF-HOSTED <br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-teal-400 to-cyan-400">AI SOFTWARE ENGINEER</span>
        </h1>

        <!-- Hero Subtitle -->
        <p class="text-base sm:text-xl md:text-2xl text-gray-300 max-w-3xl font-tech mb-10 leading-relaxed">
          Orchestrate a fleet of cloud coding agents in all of the apps your team already lives in.
          Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR. 100% inside your Cloudflare account.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 mb-16 w-full max-w-md sm:max-w-none">
          <a href="/docs/getting-started" class="w-full sm:w-auto relative group flex items-center justify-center gap-3 bg-teal-400 text-black font-display text-2xl tracking-wider px-8 py-4 rounded-2xl comic-btn-shadow border-2 border-teal-300">
            <span>Install AI Intern</span>
            <img src="/assets/capy/capy-sleeping.webp" alt="Hero Image" class="w-8 h-auto transition-transform group-hover:-translate-y-1.5" />
          </a>
          <a href="/docs/overview" class="w-full sm:w-auto flex items-center justify-center gap-2 bg-zinc-900/90 text-white font-tech text-base px-7 py-4 rounded-2xl border-2 border-white/15 hover:border-teal-400/50 hover:bg-zinc-800 transition-all shadow-[4px_4px_0px_0px_rgba(255,255,255,0.08)]">
            <span>Read the Docs</span>
            <span class="text-teal-400">→</span>
          </a>
        </div>

        <!-- Social Proof Marquee -->
        <div class="w-full mb-16">
          <p class="text-xs sm:text-sm font-tech uppercase tracking-widest text-gray-400 mb-6">
            Loved by <span class="text-teal-400 font-bold">70,000+ engineers</span> at
          </p>

          <div class="relative w-full overflow-hidden py-4 border-y border-white/5 bg-black/40">
            <div class="flex animate-marquee gap-12 sm:gap-16 items-center">
              <img src="/assets/capy/autumn.svg" alt="Autumn" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/supermemory.svg" alt="Supermemory" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/exa.svg" alt="Exa" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/loop.svg" alt="Loop" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/million.svg" alt="Million" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/goblins.svg" alt="Goblins" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/runpod.svg" alt="RunPod" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              
              <!-- Repeat for infinite ticker -->
              <img src="/assets/capy/autumn.svg" alt="Autumn" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/supermemory.svg" alt="Supermemory" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/exa.svg" alt="Exa" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/loop.svg" alt="Loop" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/million.svg" alt="Million" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/goblins.svg" alt="Goblins" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
              <img src="/assets/capy/runpod.svg" alt="RunPod" class="h-6 sm:h-7 opacity-70 hover:opacity-100 transition-opacity grayscale hover:grayscale-0" />
            </div>
          </div>
        </div>

        <!-- Manga Hero Illustration & Terminal Panel -->
        <div class="w-full max-w-5xl rounded-2xl overflow-hidden border-2 border-white/20 bg-zinc-950 comic-card-teal relative text-left">
          <!-- Window Header -->
          <div class="bg-zinc-900 border-b border-white/10 px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
              <span class="ml-3 font-tech text-xs text-gray-400">capy-agent-daemon :: v2.4.0 (active)</span>
            </div>
            <button id="hero-replay-btn" class="font-tech text-xs bg-teal-500/20 text-teal-300 border border-teal-500/40 px-3 py-1 rounded-lg hover:bg-teal-500/30 transition-colors flex items-center gap-1.5">
              <span>↻ Replay</span>
            </button>
          </div>

          <!-- Hero Image & Manga Art Container -->
          <div class="relative w-full h-[360px] sm:h-[480px] bg-black overflow-hidden flex items-center justify-center">
            <img src="/assets/capy/manga-bg.webp" alt="Hero Image" class="w-full h-full object-cover opacity-80 filter contrast-125" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>

            <!-- Terminal Card Overlay -->
            <div class="absolute bottom-6 left-6 right-6 sm:left-10 sm:right-10 bg-zinc-900/90 border border-teal-500/30 backdrop-blur-md p-5 rounded-xl font-tech text-xs sm:text-sm text-gray-200 shadow-2xl">
              <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
                  <span class="text-teal-400 font-bold">TASK_RUNNING:</span>
                  <span class="text-gray-300">Migrate legacy SPA to Tanstack & Cloudflare Sandbox</span>
                </div>
                <span class="text-[11px] bg-teal-400/20 text-teal-300 px-2 py-0.5 rounded border border-teal-400/40">Step 4/6 Completed</span>
              </div>
              <div class="space-y-1.5 text-gray-300">
                <div class="text-emerald-400">✓ [sandbox-init] Container spinup time: 142ms</div>
                <div class="text-emerald-400">✓ [audit] Zero vulnerabilities found across 38 packages</div>
                <div class="text-teal-300">→ [code-edit] Applied 14 file modifications across src/ and test/</div>
                <div class="text-gray-400">↳ Verification: 203 unit tests passed (100% success rate)</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: USE CASES -->
    <section id="use-cases" class="py-24 border-t border-white/10 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
          <div>
            <div class="inline-flex items-center gap-2 bg-amber-400/10 text-amber-300 border border-amber-400/30 px-3 py-1 rounded-full text-xs font-tech font-bold uppercase mb-4">
              <img src="/assets/capy/lightbulb.529c5ef0.webp" alt="Light bulb" class="w-4 h-4 object-contain" />
              <span>USE CASES</span>
            </div>
            <h2 class="font-display text-4xl sm:text-6xl text-white tracking-wide">
              From clearing hundreds of tickets at once <br class="hidden sm:block" />
              to running security audits on a schedule.
            </h2>
          </div>
          <a href="/docs/dashboard" class="mt-6 md:mt-0 inline-flex items-center gap-2 font-tech text-sm text-teal-400 hover:text-teal-300 border-b border-teal-400 pb-1">
            <span>Explore all capabilities →</span>
          </a>
        </div>

        <!-- 6 Use Case Grid Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1: E2E Testing -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-teal-400/10 text-teal-300 border border-teal-400/30 px-2 py-0.5 rounded">Desktop / Web</span>
                <span class="text-xs text-gray-500 font-tech">Waking up...</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">E2E TESTING</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Take your agent runs end to end with native computer use, browser use and annotated videos.</p>
            </div>
            <div class="bg-black/80 rounded-xl p-4 border border-white/5 font-tech text-xs text-gray-300 space-y-2">
              <div class="flex items-center gap-2 text-teal-400">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
                <span>Running Playwright headless suite</span>
              </div>
              <div class="bg-zinc-950 p-2.5 rounded border border-white/5 text-[11px] text-gray-400">
                <span>PASS test/e2e/checkout.spec.ts (4.2s)</span><br />
                <span class="text-emerald-400">✓ User completes flow without layout shift</span>
              </div>
            </div>
          </div>

          <!-- Card 2: Bug Triage and Fix -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-purple-400/10 text-purple-300 border border-purple-400/30 px-2 py-0.5 rounded">Slack + GitHub</span>
                <span class="text-xs text-gray-500 font-tech">SCO-15215</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">BUG TRIAGE AND FIX</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Triage, fix and merge bug fixes right where you work. Have your product fix itself.</p>
            </div>
            <div class="bg-black/80 rounded-xl p-3.5 border border-white/5 font-tech text-xs space-y-3">
              <div class="flex items-start gap-2.5">
                <img src="/assets/capy/lisa.9f2cd3d0.webp" alt="lisa" class="w-6 h-6 rounded-full mt-0.5" />
                <div>
                  <div class="text-gray-400 text-[11px]"><span class="text-white font-bold">lisa</span> 2:47 PM</div>
                  <p class="text-gray-300 text-xs">@Capy can you help me with this new bug reported?</p>
                </div>
              </div>
              <div class="flex items-start gap-2.5 bg-teal-950/30 p-2.5 rounded-lg border border-teal-500/20">
                <img src="/assets/capy/capy-avatar-1.webp" alt="Capy" class="w-6 h-6 rounded-full mt-0.5" />
                <div>
                  <div class="text-teal-400 text-[11px] font-bold">Capy APP 2:47 PM</div>
                  <p class="text-gray-300 text-xs">Sniffing the air... Fix sign-up form data. PR opened: #546</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 3: Code Review -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-amber-400/10 text-amber-300 border border-amber-400/30 px-2 py-0.5 rounded">Security & Quality</span>
                <span class="text-xs text-emerald-400 font-tech">4 Audited</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">CODE REVIEW</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Break the review bottleneck with Capy's inbuilt review agent, run on every PR.</p>
            </div>
            <div class="space-y-2 font-tech text-xs">
              <div class="bg-black/90 p-2.5 rounded-xl border border-white/10 flex items-center justify-between review-item">
                <div class="flex items-center gap-2">
                  <img src="/assets/capy/capy-6.7750e934.webp" alt="Review Capy" class="w-5 h-5 rounded-full" />
                  <span class="text-gray-300 text-[11px]">Timing-unsafe credential comparison</span>
                </div>
                <button class="text-[10px] text-teal-400 hover:text-white border border-teal-500/40 px-2 py-0.5 rounded resolve-btn">Mark resolved</button>
              </div>
              <div class="bg-black/90 p-2.5 rounded-xl border border-white/10 flex items-center justify-between review-item">
                <div class="flex items-center gap-2">
                  <img src="/assets/capy/capy-6.7750e934.webp" alt="Review Capy" class="w-5 h-5 rounded-full" />
                  <span class="text-gray-300 text-[11px]">Session cookie missing Secure flags</span>
                </div>
                <button class="text-[10px] text-teal-400 hover:text-white border border-teal-500/40 px-2 py-0.5 rounded resolve-btn">Mark resolved</button>
              </div>
            </div>
          </div>

          <!-- Card 4: Migration, Backlog, Refactor -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-emerald-400/10 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded">Refactor</span>
                <span class="text-xs text-gray-500 font-tech">package-lock.json</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">MIGRATION & REFACTOR</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Run hundreds of parallel agents at the same time. Remove busywork for good.</p>
            </div>
            <div class="bg-black/80 rounded-xl p-3 border border-white/5 font-tech text-xs">
              <div class="text-[11px] text-gray-400 mb-2 font-bold">Migrate SPA Nextjs to Tanstack Start (+14,590 -23,585)</div>
              <div class="space-y-1 text-[11px]">
                <div class="diff-line-del px-2 py-0.5">-"next": "14.2.3",</div>
                <div class="diff-line-add px-2 py-0.5">+"@tanstack/react-start": "1.121.2",</div>
                <div class="diff-line-add px-2 py-0.5">+"@tanstack/react-router": "1.121.2"</div>
              </div>
            </div>
          </div>

          <!-- Card 5: Bring Your Own Subscription -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-blue-400/10 text-blue-300 border border-blue-400/30 px-2 py-0.5 rounded">BYO Subscription</span>
                <span class="text-xs text-teal-400 font-tech">Active</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">BRING YOUR OWN KEY</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Connect Codex, Copilot, or SuperGrok and Capy runs on the plans you already pay for.</p>
            </div>
            <div class="space-y-2 font-tech text-xs">
              <div class="bg-black/80 p-2.5 rounded-xl border border-white/5 flex items-center justify-between">
                <div>
                  <div class="text-white font-bold">Codex</div>
                  <div class="text-[10px] text-gray-400">haris@capy.ai · 34% used</div>
                </div>
                <span class="text-teal-400 text-xs font-bold">Connected</span>
              </div>
              <div class="bg-black/80 p-2.5 rounded-xl border border-white/5 flex items-center justify-between">
                <div>
                  <div class="text-white font-bold">GitHub Copilot</div>
                  <div class="text-[10px] text-gray-400">harismehrzad · 18% used</div>
                </div>
                <span class="text-teal-400 text-xs font-bold">Connected</span>
              </div>
            </div>
          </div>

          <!-- Card 6: Automations -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-rose-400/10 text-rose-300 border border-rose-400/30 px-2 py-0.5 rounded">Automations</span>
                <span class="text-xs text-gray-400 font-tech">Cron / Webhook</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">AUTOMATIONS</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Update docs, clean up code, run security audits. Run anything on trigger or cron.</p>
            </div>
            <div class="bg-black/80 rounded-xl p-3 border border-white/5 font-tech text-xs space-y-2">
              <div class="text-teal-300 font-bold text-[11px]">Trigger: Any message in #acme-channel with bug</div>
              <div class="text-gray-400 text-[11px]">↳ Target: frontend (main)</div>
              <div class="text-emerald-400 text-[11px] font-bold">Status: Created & Listening</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- MANGA SCENE TRANSITION STRIP -->
    <section class="relative w-full py-16 bg-black overflow-hidden border-y border-white/10">
      <img src="/assets/capy/use-case-bg.b9d62ab8.webp" alt="Manga cityscape" class="absolute inset-0 w-full h-full object-cover opacity-35" />
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-8 z-10">
        <div class="max-w-xl">
          <span class="font-comic text-2xl sm:text-3xl text-teal-400 tracking-wider">MEANWHILE IN PRODUCTION...</span>
          <h3 class="font-display text-3xl sm:text-5xl text-white mt-2">NO MORE MIDNIGHT INCIDENT PANIC.</h3>
          <p class="font-tech text-sm text-gray-300 mt-2">Agents autonomously investigate alarms, reproduce errors, and present verified remediation PRs.</p>
        </div>
        <img src="/assets/capy/capy-struggling-to-climb.9288d165.webp" alt="Capy climbing" class="w-48 sm:w-64 h-auto object-contain filter drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)]" />
      </div>
    </section>

    <!-- SECTION: FEATURES FOR A MODERN DEV TEAM -->
    <section id="features" class="py-24 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 bg-teal-400/10 text-teal-300 border border-teal-400/30 px-3 py-1 rounded-full text-xs font-tech font-bold uppercase mb-4">
            <img src="/assets/capy/feature.f873fd82.webp" alt="Capy face" class="w-4 h-4 object-contain" />
