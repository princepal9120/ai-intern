---
import '../styles/tailwind.css';
import '../styles/theme.css';
---
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/assets/mascot/doge-avatar.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Intern - The best AI software engineer</title>
  <meta name="description" content="Open source self-hosted coding agent on Cloudflare Workers and Sandbox containers. Delegate tasks to parallel coding agents with approval gates." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Bebas+Neue&family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Bangers&display=swap');
    
    :root {
      --brand-primary: #0B9F95;
      --brand-primary-hover: #0ea5e9;
      --brand-primary-light: #2dd4bf;
      --brand-primary-dark: #097d75;
      --brand-primary-glow: rgba(11, 159, 149, 0.25);
    }
    body {
      background-color: #08090b !important;
      color: #f3f4f6 !important;
      font-family: 'Inter', system-ui, sans-serif;
      margin: 0;
      padding: 0;
    }
    .font-display {
      font-family: 'Bebas Neue', Impact, sans-serif !important;
      letter-spacing: 0.04em;
    }
    .font-comic {
      font-family: 'Bangers', 'Comic Sans MS', cursive, sans-serif !important;
      letter-spacing: 0.05em;
    }
    .font-tech {
      font-family: 'DM Mono', 'Geist Mono', monospace !important;
    }
    .grid-bg {
      background-size: 32px 32px;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
      mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.2) 70%, rgba(0,0,0,0) 100%);
      -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(0, 0, 0, 0.2) 70%, rgba(0,0,0,0) 100%);
    }
    .comic-btn-shadow {
      box-shadow: 4px 4px 0px 0px #0B9F95;
      transition: all 0.15s ease;
    }
    .comic-btn-shadow:hover {
      box-shadow: 1px 1px 0px 0px #0B9F95;
      transform: translate(3px, 3px);
    }
    .comic-card-shadow {
      box-shadow: 6px 6px 0px 0px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    }
    .comic-card-teal {
      box-shadow: 6px 6px 0px 0px rgba(11, 159, 149, 0.4), inset 0 0 0 1px rgba(11, 159, 149, 0.3);
    }
    @keyframes marquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .animate-marquee {
      display: flex;
      width: max-content;
      animation: marquee 25s linear infinite;
    }
    .animate-marquee:hover {
      animation-play-state: paused;
    }
    .animate-marquee-slow {
      display: flex;
      width: max-content;
      animation: marquee 45s linear infinite;
    }
    .diff-line-add {
      background-color: rgba(34, 197, 94, 0.15);
      color: #4ade80;
      border-left: 2px solid #22c55e;
    }

    @keyframes mascot-float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(-2deg); }
    }
    @keyframes mascot-breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }
    @keyframes mascot-wiggle {
      0%, 100% { transform: rotate(0deg); }
      25% { transform: rotate(-8deg); }
      75% { transform: rotate(8deg); }
    }
    @keyframes mascot-sway {
      0%, 100% { transform: rotate(-4deg) translateY(0); }
      50% { transform: rotate(4deg) translateY(-5px); }
    }
    @keyframes mascot-bounce {
      0%, 100% { transform: translateY(0); }
      40% { transform: translateY(-12px); }
      60% { transform: translateY(-4px); }
    }
    .mascot-floating {
      animation: mascot-float 4s ease-in-out infinite;
    }
    .mascot-breathing {
      animation: mascot-breathe 3.2s ease-in-out infinite;
      transform-origin: bottom center;
    }
    .mascot-swaying {
      animation: mascot-sway 3.5s ease-in-out infinite;
      transform-origin: top center;
    }
    .mascot-bouncing {
      animation: mascot-bounce 2.6s ease infinite;
    }
    .mascot-hover-wiggle:hover {
      animation: mascot-wiggle 0.5s ease-in-out infinite;
    }
    .diff-line-del {
      background-color: rgba(239, 68, 68, 0.15);
      color: #f87171;
      border-left: 2px solid #ef4444;
    }
  </style>
</head>
<body class="font-sans antialiased bg-[#08090b] text-gray-100 selection:bg-teal-400 selection:text-black overflow-x-hidden">
  <div class="fixed inset-0 z-[-1] grid-bg h-screen w-full pointer-events-none"></div>

  <!-- Announcement Bar (Verified Open Source Release) -->
  <div class="bg-gradient-to-r from-teal-950 via-zinc-900 to-teal-950 border-b border-teal-500/20 py-2.5 px-4 text-center text-xs sm:text-sm font-tech">
    <a href="/docs/overview" class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors group">
      <span class="bg-teal-400/10 text-teal-400 border border-teal-400/30 px-2 py-0.5 rounded-full text-[11px] font-bold tracking-wide uppercase">Open Source Release</span>
      <img src="/assets/mascot/doge-avatar.svg" alt="Doge Team" class="w-5 h-5 rounded-full inline-block object-contain" style="width: 20px; height: 20px;" />
      <span class="font-medium text-white group-hover:underline">v0.2.0 is live: Self-hosted coding agent on Cloudflare Workers and Sandbox</span>
      <span class="text-teal-400 font-bold ml-1 transition-transform group-hover:translate-x-1">→</span>
    </a>
  </div>

  <!-- Sticky Header -->
  <header class="sticky top-0 z-50 w-full border-b border-white/10 bg-[#08090b] shadow-xl">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-18 py-3 flex items-center justify-between">
      <div class="flex items-center gap-8">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 via-teal-400 to-teal-600 flex items-center justify-center p-1 shadow-[2px_2px_0px_0px_#fff]">
            <img src="/assets/mascot/doge-avatar.svg" alt="Doge Mascot" class="w-full h-full object-contain" style="width: 34px; height: 34px;" />
          </div>
          <div class="flex flex-col text-left">
            <span class="font-display text-2xl sm:text-3xl tracking-wide text-white leading-none">AI INTERN</span>
            <span class="font-tech text-[10px] text-teal-400 tracking-wider">100% OPEN SOURCE</span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-6 font-tech text-sm">
          <a href="#use-cases" class="text-gray-300 hover:text-white hover:underline transition-colors">Use Cases</a>
          <a href="#features" class="text-gray-300 hover:text-white hover:underline transition-colors">Features</a>
          <a href="#security" class="text-gray-300 hover:text-white hover:underline transition-colors">Security</a>
          <a href="#pricing" class="text-gray-300 hover:text-white hover:underline transition-colors">Self-Hosting</a>
          <a href="/docs/overview" class="text-gray-300 hover:text-white hover:underline transition-colors">Docs</a>
          <a href="https://github.com/princepal9120/ai-intern" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white hover:underline transition-colors flex items-center gap-1">
            <span>GitHub</span>
            <span class="text-xs text-teal-400">↗</span>
          </a>
        </nav>
      </div>

      <div class="flex items-center gap-3 sm:gap-4">
        <a href="/app" class="hidden sm:inline-block font-tech text-sm text-gray-300 hover:text-white transition-colors px-3 py-1.5">Dashboard</a>
        <a href="/docs/getting-started" class="relative group inline-flex items-center gap-2 font-display text-lg tracking-wider bg-teal-400 text-black px-5 py-2 rounded-xl comic-btn-shadow border border-teal-300">
          <span>Get started</span>
          <img src="/assets/mascot/doge-sleeping.svg" alt="Doge resting" class="w-7 h-auto -mr-1 transition-transform group-hover:-translate-y-1" style="width: 28px; height: 18px;" />
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION (Synara-style classical temple atmosphere + animated mascot animations) -->
    <section class="relative pt-12 sm:pt-20 pb-24 overflow-hidden text-center">
      <!-- Synara-inspired Temple Ruins & Atmospheric Night Backdrop -->
      <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
        <!-- Sky background texture with subtle cosmic blend -->
        <div class="absolute inset-0 bg-cover bg-center opacity-30 mix-blend-screen filter saturate-150" style="background-image: url('/assets/synara/hero-bg.jpg');"></div>
        
        <!-- Classical Greco-Roman temple ruins from Synara, bathed in moonlight and starry skies -->
        <img
          src="/assets/synara/hero-temple-night.png"
          alt="Classical temple ruins backdrop"
          class="absolute top-0 right-0 sm:-right-8 md:right-0 max-w-4xl lg:max-w-6xl w-full h-auto object-cover opacity-65 -scale-x-100 filter brightness-110 contrast-110"
          style="mask-image: radial-gradient(ellipse 85% 70% at 75% 35%, black 40%, transparent 85%); -webkit-mask-image: radial-gradient(ellipse 85% 70% at 75% 35%, black 40%, transparent 85%);"
        />
        
        <!-- Atmospheric lighting glows -->
        <div class="absolute top-10 right-1/4 w-[500px] h-[500px] rounded-full bg-teal-500/15 blur-[120px]"></div>
        <div class="absolute top-24 left-1/4 w-[400px] h-[400px] rounded-full bg-amber-500/10 blur-[140px]"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#08090b] to-transparent"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col items-center relative z-10">
        <!-- Synara-inspired Provider Portability Badge Bar -->
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-zinc-900/90 border border-white/15 backdrop-blur-md text-xs font-tech text-gray-300 mb-8 shadow-xl hover:border-teal-400/40 transition-all">
          <div class="flex items-center gap-2 border-r border-white/15 pr-3">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-white font-semibold">MULTI-HARNESS READY</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="px-2 py-0.5 rounded bg-zinc-800 text-teal-300 font-bold text-[11px]">Claude Code</span>
            <span class="px-2 py-0.5 rounded bg-zinc-800 text-cyan-300 font-bold text-[11px]">OpenCode</span>
            <span class="px-2 py-0.5 rounded bg-zinc-800 text-purple-300 font-bold text-[11px]">Codex</span>
            <span class="px-2 py-0.5 rounded bg-zinc-800 text-amber-300 font-bold text-[11px]">Gemini 2.5 Flash</span>
          </div>
        </div>

        <!-- Hero Headline -->
        <h1 class="font-display text-5xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight text-white uppercase leading-[0.9] max-w-5xl mb-6 drop-shadow-2xl">
          THE BEST SELF-HOSTED <br class="hidden sm:block" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-300 via-teal-400 to-cyan-400">AI SOFTWARE ENGINEER</span>
        </h1>

        <!-- Hero Subtitle -->
        <p class="text-base sm:text-xl md:text-2xl text-gray-200 max-w-3xl font-tech mb-10 leading-relaxed drop-shadow-md">
          Delegate tasks to parallel coding agents that plan, build, and ship from task to reviewable PR.
          Runs entirely inside your own Cloudflare account with isolated micro-containers and approval gates.
        </p>

        <!-- CTA Buttons with animated Resting Mascot -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-16 w-full max-w-md sm:max-w-none">
          <div class="relative group w-full sm:w-auto">
            <!-- animated mascot sleeping directly on top of button with breathing & hover animation -->
            <div class="absolute -top-7 right-6 sm:right-4 z-20 pointer-events-none transition-transform duration-300 group-hover:-translate-y-2 group-hover:scale-110">
              <img src="/assets/mascot/doge-sleeping.svg" alt="Doge resting" class="w-14 h-auto drop-shadow-lg mascot-breathing" style="width: 56px; height: 35px;" />
            </div>
            <a href="/docs/getting-started" class="w-full sm:w-auto relative flex items-center justify-center gap-3 bg-teal-400 text-black font-display text-2xl tracking-wider px-9 py-4 rounded-2xl comic-btn-shadow border-2 border-teal-300 hover:bg-teal-300 transition-all">
              <span>Install AI Intern</span>
              <span class="text-xl font-bold">→</span>
            </a>
          </div>

          <a href="https://github.com/princepal9120/ai-intern" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto flex items-center justify-center gap-2 bg-zinc-900/90 text-white font-tech text-base px-7 py-4 rounded-2xl border-2 border-white/15 hover:border-teal-400/50 hover:bg-zinc-800 transition-all shadow-[4px_4px_0px_0px_rgba(255,255,255,0.08)]">
            <span>View Source on GitHub</span>
            <span class="text-teal-400">↗</span>
          </a>
        </div>

        <!-- Verified Open Source Tech Stack Marquee (No fabricated numbers) -->
        <div class="w-full mb-16">
          <p class="text-xs sm:text-sm font-tech uppercase tracking-widest text-gray-400 mb-6">
            BUILT ON MODERN OPEN SOURCE AND CLOUDFLARE RUNTIMES
          </p>

          <div class="relative w-full overflow-hidden py-4 border-y border-white/5 bg-black/40">
            <div class="flex animate-marquee gap-8 sm:gap-12 items-center font-tech text-xs uppercase tracking-wider text-gray-400">
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Cloudflare Workers</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Sandbox Micro-Containers</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">OpenCode Interpreter</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">React 19 Dashboard</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Astro Starlight</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">TypeScript 5.9</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Vitest 239/239 Tests</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Cloudflare AI Gateway</span>

              <!-- Duplicate for marquee -->
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Cloudflare Workers</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Sandbox Micro-Containers</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">OpenCode Interpreter</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">React 19 Dashboard</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Astro Starlight</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">TypeScript 5.9</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Vitest 239/239 Tests</span>
              <span class="px-3 py-1 bg-zinc-900 rounded border border-white/10 text-white font-bold">Cloudflare AI Gateway</span>
            </div>
          </div>
        </div>

        <!-- HERO BATTLESTATION CONTAINER WITH MASCOT -->
        <div class="w-full max-w-5xl rounded-2xl overflow-hidden border-2 border-white/20 bg-zinc-950 comic-card-teal relative text-left shadow-2xl">
          <!-- Window Header -->
          <div class="bg-zinc-900 border-b border-white/10 px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500 inline-block"></span>
              <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
              <span class="ml-3 font-tech text-xs text-gray-400">doge-agent-daemon :: v2.4.0 (active)</span>
            </div>
            <button id="hero-replay-btn" class="font-tech text-xs bg-teal-500/20 text-teal-300 border border-teal-500/40 px-3 py-1 rounded-lg hover:bg-teal-500/30 transition-colors flex items-center gap-1.5">
              <span>↻ Replay</span>
            </button>
          </div>

          <!-- Hero Illustration: Dog Mascot at Battlestation -->
          <div class="relative w-full bg-black overflow-hidden flex items-center justify-center p-2 sm:p-4">
            <img src="/assets/mascot/doge-hero-battlestation.svg" alt="Hero Image" class="w-full h-auto object-contain filter contrast-125" style="max-height: 520px;" />
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/20 to-transparent pointer-events-none"></div>

            <!-- Terminal Card Overlay -->
            <div class="absolute bottom-4 left-4 right-4 sm:left-8 sm:right-8 bg-zinc-900/90 border border-teal-500/30 backdrop-blur-md p-4 sm:p-5 rounded-xl font-tech text-xs sm:text-sm text-gray-200 shadow-2xl">
              <div class="flex items-center justify-between pb-2 sm:pb-3 mb-2 sm:mb-3 border-b border-white/10">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-teal-400 animate-ping"></span>
                  <span class="text-teal-400 font-bold">TASK_RUNNING:</span>
                  <span class="text-gray-300">Migrate legacy code in Cloudflare Sandbox container</span>
                </div>
                <span class="text-[11px] bg-teal-400/20 text-teal-300 px-2 py-0.5 rounded border border-teal-400/40">Step 4/6 Completed</span>
              </div>
              <div class="space-y-1 text-gray-300 text-xs">
                <div class="text-emerald-400">✓ [sandbox-init] Container spinup time: 142ms</div>
                <div class="text-emerald-400">✓ [approval-gate] Delegation confirmed by repository owner</div>
                <div class="text-teal-300">→ [code-edit] Applied 14 file modifications in isolated checkout</div>
                <div class="text-gray-400">↳ Verification: 239 unit tests passed with zero regressions</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION: USE CASES -->
    <section id="use-cases" class="py-24 border-t border-white/10 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-16">
          <div>
            <div class="inline-flex items-center gap-2 bg-amber-400/10 text-amber-300 border border-amber-400/30 px-3 py-1 rounded-full text-xs font-tech font-bold uppercase mb-4">
              <img src="/assets/mascot/doge-mascot-sunglasses.svg" alt="Light bulb" class="w-4 h-4 object-contain" style="width: 16px; height: 16px;" />
              <span>USE CASES</span>
            </div>
            <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl text-white tracking-wide max-w-4xl leading-tight">
              Tackle real pull requests, issue triage, and code migrations without granting blind access.
            </h2>
          </div>
          <a href="/docs/dashboard" class="mt-6 md:mt-0 inline-flex items-center gap-2 font-tech text-sm text-teal-400 hover:text-teal-300 border-b border-teal-400 pb-1">
            <span>Explore all capabilities →</span>
          </a>
        </div>

        <!-- 6 Use Case Grid Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card 1: E2E Testing -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-teal-400/10 text-teal-300 border border-teal-400/30 px-2 py-0.5 rounded">Desktop / Web</span>
                <span class="text-xs text-gray-500 font-tech">Waking up...</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">E2E TESTING</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Take agent runs end to end with headless browser execution and terminal inspection.</p>
            </div>
            <div class="bg-black/80 rounded-xl p-4 border border-white/5 font-tech text-xs text-gray-300 space-y-2">
              <div class="flex items-center gap-2 text-teal-400">
                <span class="w-1.5 h-1.5 rounded-full bg-teal-400"></span>
                <span>Running Playwright test suite</span>
              </div>
              <div class="bg-zinc-950 p-2.5 rounded border border-white/5 text-[11px] text-gray-400">
                <span>PASS test/e2e/checkout.spec.ts (4.2s)</span><br />
                <span class="text-emerald-400">✓ User completes flow without layout shift</span>
              </div>
            </div>
          </div>

          <!-- Card 2: Bug Triage and Fix -->
          <div class="bg-zinc-900/90 border border-white/10 rounded-2xl p-6 comic-card-shadow flex flex-col justify-between hover:border-teal-400/40 transition-colors">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="font-tech text-xs bg-purple-400/10 text-purple-300 border border-purple-400/30 px-2 py-0.5 rounded">Slack + GitHub</span>
                <span class="text-xs text-gray-500 font-tech">SCO-15215</span>
              </div>
              <h3 class="font-display text-2xl text-white tracking-wide mb-2">BUG TRIAGE AND FIX</h3>
              <p class="font-tech text-sm text-gray-400 mb-6">Triage, reproduce, and fix bug reports right where you work. Let code fix itself safely.</p>
            </div>
            <div class="bg-black/80 rounded-xl p-3.5 border border-white/5 font-tech text-xs space-y-3">
              <div class="flex items-start gap-2.5">
                <img src="/assets/mascot/doge-avatar.svg" alt="AI Intern mascot" class="w-6 h-6 rounded-full mt-0.5 object-cover" style="width: 24px; height: 24px;" />
                <div>
                  <div class="text-gray-400 text-[11px]"><span class="text-white font-bold">developer</span> 2:47 PM</div>
                  <p class="text-gray-300 text-xs">Can you reproduce and patch this login rate-limit failure?</p>
                </div>
